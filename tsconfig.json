{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "inlineSourceMap": false,
    "module": "esnext",
    "target": "esnext",
    "allowJs": true,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowSyntheticDefaultImports":true,
  },
  "include": [
    "**/*.ts"
  ]
}
